# Copy to .env.local and fill in.

# Shared secret for the separate admin app (admin-dashboard/). The admin calls
# /api/admin with "Authorization: Bearer <token>"; put the same value in
# admin-dashboard/.env.local. Leave empty to disable the admin API (503).
ADMIN_API_TOKEN=

# Supabase — leave empty to store in .data/db.json locally
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email (meeting-point emails for test drives). Without a key, emails are kept
# in the admin's Emails outbox but not delivered. https://resend.com
RESEND_API_KEY=
MAIL_FROM="Roadster <bookings@your-domain.com>"
# Public address of this site, used for links inside emails
PUBLIC_SITE_URL=http://localhost:3100
