# Copy to .env.local and fill in.

# Admin dashboard (/admin): login password + cookie signing secret
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional JSON feed for integrations: GET /api/admin?resource=orders
#   Authorization: Bearer <token>
ADMIN_API_TOKEN=

# Indicative USD→NGN display rate on the reservation page
NEXT_PUBLIC_NGN_PER_USD=1550

# Supabase — leave empty to store in .data/db.json locally
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
